# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 6150-6199 so that they rarely collide with other local services.
DEV_HOST=localhost
# the dev servers are on loopback: allowed to the SSRF-safe http clients of the api (the export calls data-fair at
# the public url of the site) and the tests
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=6150
DEV_API_PORT=6151
DEV_UI_PORT=6152
DEV_UI_HMR_PORT=6153
MONGO_PORT=6154
SD_PORT=6155
DF_PORT=6156
ES_PORT=6157
# simple-directory's SMTP target: nothing listens there, metrics has no mail flow of its own
MAILDEV_SMTP_PORT=6158
