{
  "$id": "https://github.com/data-fair/metrics/agg-query",
  "x-exports": ["types", "validate"],
  "title": "agg query",
  "type": "object",
  "additionalProperties": false,
  "required": ["start", "end"],
  "properties": {
    "start": {
      "type": "string",
      "format": "date"
    },
    "end": {
      "type": "string",
      "format": "date"
    },
    "operationTrack": {"$ref": "https://github.com/data-fair/metrics/daily-api-metric#/$defs/operationTrack"},
    "statusClass": {"$ref": "https://github.com/data-fair/metrics/daily-api-metric#/$defs/statusClass"},
    "userClass": {
      "oneOf": [
        {"$ref": "https://github.com/data-fair/metrics/daily-api-metric#/$defs/userClass"},
        {
          "type": "array",
          "items": {"$ref": "https://github.com/data-fair/metrics/daily-api-metric#/$defs/userClass"},
          "minItems": 1
        }
      ]
    },
    "resourceType": {"type": "string"},
    "resourceId": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "refererDomain": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "refererCategory": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "refererApp": {
      "description": "ids of the applications whose pages sent the requests",
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "topicId": {"type": "string"},
    "showAll": {
      "type": "string",
      "enum": ["true", "false"],
      "description": "super admin in admin mode only: aggregate the metrics of every account instead of the active one"
    },
    "owner": {
      "description": "with showAll=true only: restrict to some accounts, as type:id or type:id:department",
      "oneOf": [
        {"$ref": "#/$defs/ownerKey"},
        {"type": "array", "items": {"$ref": "#/$defs/ownerKey"}, "minItems": 1}
      ]
    },
    "format": {
      "type": "string",
      "enum": ["series", "rows"],
      "default": "series",
      "description": "series (default) groups values by key with a nested day map, rows returns one flat row per group"
    },
    "size": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,3}|10000)$",
      "description": "maximum number of rows returned when format=rows, from 1 to 10000 (default 1000)"
    },
    "split": {
      "type": "array",
      "items": { "type": "string", "enum": ["day", "resource", "operationTrack", "statusClass", "userClass", "refererApp", "refererDomain", "refererCategory", "owner"] }
    }
  },
  "$defs": {
    "ownerKey": {"type": "string", "pattern": "^(user|organization):[^:]+(:[^:]+)?$"}
  }
}
