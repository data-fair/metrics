{
  "tools": [
    {
      "name": "aggregate_requests",
      "description": "Count the HTTP requests received by the active account's datasets and applications over a period, filtered and grouped by the dimensions given in split. Returns one row per group with nbRequests, bytes and meanDuration (seconds), sorted by day then by number of requests.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date",
            "description": "First day of the period, format YYYY-MM-DD."
          },
          "end": {
            "type": "string",
            "format": "date",
            "description": "Last day of the period (included), format YYYY-MM-DD."
          },
          "split": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "day",
                "resource",
                "operationTrack",
                "statusClass",
                "userClass",
                "refererApp",
                "refererDomain",
                "refererCategory"
              ]
            },
            "description": "Dimensions to group by, as an array. Example: [\"resource\"] for the most used resources, [\"day\", \"operationTrack\"] for a time series per kind of usage, [] for the totals of the period. Omitted means [\"day\"]."
          },
          "operationTrack": {
            "type": "string",
            "enum": [
              "readDataAPI",
              "openApplication",
              "readDataFiles"
            ],
            "description": "Kind of operation."
          },
          "statusClass": {
            "type": "string",
            "enum": [
              "info",
              "ok",
              "redirect",
              "clientError",
              "serverError"
            ],
            "description": "Class of the HTTP response status."
          },
          "userClass": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "anonymous",
                "owner",
                "external",
                "ownerProcessing",
                "externalProcessing",
                "ownerAPIKey",
                "externalAPIKey"
              ]
            },
            "description": "Classes of users."
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "datasets",
              "applications"
            ],
            "description": "Type of resource."
          },
          "resourceId": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Restrict to some resources, as an array of dataset or application ids. Combine with resourceType."
          },
          "refererDomain": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Domains of the calling sites."
          },
          "refererCategory": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "backoffice",
                "embed",
                "app",
                "mcp",
                "other"
              ]
            },
            "description": "Categories of the calling sites."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100,
            "description": "Maximum number of rows. The response count says how many groups exist in total."
          }
        },
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "security": [
        {
          "sdCookie": []
        },
        {
          "oauth2": [
            "metrics:read"
          ]
        },
        {
          "oauth2": [
            "metrics"
          ]
        },
        {
          "oauth2": [
            "all:read"
          ]
        },
        {
          "oauth2": [
            "all:write"
          ]
        },
        {
          "oauth2": [
            "all:admin"
          ]
        }
      ]
    }
  ],
  "skills": [
    {
      "id": "review",
      "name": "review",
      "description": "How to review the audience of the account's datasets and applications with metrics_aggregate_requests: totals, breakdowns, time series and period comparisons. Read it before analysing metrics.",
      "digest": "sha256:287e5b56d1b0a2782b0751a88201d9cc03af7f40b103ff870f919329a5b042e0"
    }
  ]
}
